---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestNotes = notes.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Informal Engineer, everything tested, numbers included</title>
    <meta
      name="description"
      content="Engineered guides for people who build their own infrastructure, homelab, self-hosted AI, and the tools around them. Everything tested, numbers included."
    />
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #101214;
        color: #e8eaed;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 42rem;
        padding: 3rem 1.5rem;
      }
      .kicker {
        font-family: ui-monospace, monospace;
        font-size: 0.85rem;
        color: #7dd3a0;
        margin-bottom: 1.5rem;
      }
      h1 {
        font-size: 1.9rem;
        line-height: 1.3;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
      }
      .sub {
        color: #9aa0a6;
        font-size: 1.1rem;
      }
      .status {
        margin-top: 3rem;
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        color: #5f6368;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="kicker">informalengineer.com</p>
      <h1>
        Engineered guides for people who build their own infrastructure,
        homelab, self-hosted AI, and the tools around them.
      </h1>
      <p class="sub">Everything tested. Numbers included.</p>
      {
        latestNotes.length > 0 && (
          <ul>
            {latestNotes.map((note) => (
              <li>
                [{note.data.status}] {note.data.title}
              </li>
            ))}
          </ul>
        )
      }
      <p class="status">The lab is being set up. First guides and Lab Notes are on the way.</p>
    </main>
  </body>
</html>
