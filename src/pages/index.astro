---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latestGuide = guides[0];
const latestNotes = notes.slice(0, 3);

// Bench meter values: real counts from the content collections and the most
// recent date anything on the bench was actually tested.
const lastTested = [
  ...guides.map((g) => g.data.testedOn.date),
  ...notes.map((n) => n.data.date),
]
  .sort((a, b) => b.valueOf() - a.valueOf())[0]
  ?.toISOString()
  .slice(0, 10);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Informal Engineer, everything tested, numbers included"
  description="Engineered guides for people who build their own infrastructure, homelab, self-hosted AI, and the tools around them. Everything tested, numbers included."
>
  <h1>
    Engineered guides for people who build their own infrastructure, homelab,
    self-hosted AI, and the tools around them.
  </h1>
  <p class="lede">
    Everything tested. Numbers included. Run by an engineer who reads the 2am
    forum threads so you don't have to (I do it anyway, it's a condition).
  </p>

  <p class="lcd" style="margin-top: 1.5rem;">
    <span>guides <span class="val">{pad(guides.length)}</span></span>
    <span>lab notes <span class="val">{pad(notes.length)}</span></span>
    {lastTested && (
      <span>last test <span class="val">{lastTested}</span></span>
    )}
  </p>

  {
    latestGuide && (
      <>
        <p class="section-label">latest guide</p>
        <a class="card" href={`/guides/${latestGuide.id}/`}>
          <strong>{latestGuide.data.title}</strong>
          <p>{latestGuide.data.summary}</p>
          <div class="meta">
            {latestGuide.data.category} · {latestGuide.data.difficulty} ·{' '}
            {latestGuide.data.timeEstimate}
          </div>
        </a>
      </>
    )
  }

  <p class="section-label">latest lab notes</p>
  {
    latestNotes.map((note) => (
      <a class="card" href={`/notes/${note.id}/`}>
        <span class="badge">{note.data.status}</span>
        <strong> {note.data.title}</strong>
        <div class="meta">{note.data.date.toISOString().slice(0, 10)}</div>
      </a>
    ))
  }

  <p class="section-label">the newsletter</p>
  <p class="lede">
    Lab Notes weekly: what got tested, what the numbers said, one useful link.
    <a href="/newsletter/">Details and signup</a>, or take the
    <a href="/rss.xml">full-content RSS feed</a>, no account needed.
  </p>
</Base>
