---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const nav = [
  { href: "/guides/", label: "Guides" },
  { href: "/notes/", label: "Lab Notes" },
  { href: "/kits/", label: "Kits" },
  { href: "/northstack/", label: "Northstack" },
  { href: "/research/", label: "Research" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Informal Engineer, everything" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Lab Notes" href="/notes/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Guides" href="/guides/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <header>
      <div class="shell header-row">
        <a class="brand" href="/">informal engineer</a>
        <nav>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="sibling" href="https://meshrahman.com">by @meshrahman ↗</a>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer>
      <div class="shell">
        <p>
          Everything tested, numbers included. Run by
          <a href="https://meshrahman.com">Mesh Rahman</a>. Guides and notes are
          free forever, full-content RSS at <a href="/rss.xml">/rss.xml</a>.
        </p>
        <p class="fine">
          Some kit links are affiliate links, always disclosed on the page they
          appear on. <a href="/about/">Editorial standards</a> ·
          <a href="/newsletter/">Newsletter</a> ·
          <a href="https://github.com/InformalEngineer">GitHub</a>
        </p>
      </div>
    </footer>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #101214;
        --fg: #e8eaed;
        --muted: #9aa0a6;
        --faint: #5f6368;
        --accent: #7dd3a0;
        --border: #26292d;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, sans-serif;
        line-height: 1.65;
      }
      .shell {
        width: 100%;
        max-width: 46rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      header {
        border-bottom: 1px solid var(--border);
      }
      .header-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.25rem;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .brand {
        font-family: ui-monospace, monospace;
        font-size: 0.9rem;
        color: var(--accent);
        text-decoration: none;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9rem;
      }
      nav a:hover {
        color: var(--fg);
      }
      .sibling {
        margin-left: auto;
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        color: var(--faint);
        text-decoration: none;
      }
      .sibling:hover {
        color: var(--accent);
      }
      main {
        flex: 1;
        padding-top: 3rem;
        padding-bottom: 3rem;
      }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 0;
        font-size: 0.85rem;
        color: var(--muted);
      }
      footer .fine {
        font-size: 0.75rem;
        color: var(--faint);
      }
      a {
        color: var(--accent);
      }
      h1 {
        font-size: 1.9rem;
        line-height: 1.25;
        letter-spacing: -0.01em;
        margin: 0 0 0.75rem;
      }
      .lede {
        color: var(--muted);
        max-width: 38rem;
      }
      .badge {
        display: inline-block;
        font-family: ui-monospace, monospace;
        font-size: 0.7rem;
        padding: 0.1rem 0.5rem;
        border-radius: 3px;
        background: #1c1f22;
        color: var(--accent);
        vertical-align: middle;
      }
      .badge.ABANDONED {
        color: #e8a0a0;
      }
      .badge.TESTING {
        color: #e8d59f;
      }
      .card {
        display: block;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1rem 1.25rem;
        margin-top: 0.75rem;
        text-decoration: none;
        color: var(--fg);
      }
      .card:hover {
        border-color: var(--faint);
      }
      .card .meta {
        font-family: ui-monospace, monospace;
        font-size: 0.72rem;
        color: var(--faint);
        margin-top: 0.35rem;
      }
      .card p {
        margin: 0.25rem 0 0;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .section-label {
        font-family: ui-monospace, monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
        margin: 2.5rem 0 0.5rem;
      }
      .prose :is(h2, h3) {
        letter-spacing: -0.01em;
      }
      .prose pre {
        background: #16181b;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.85rem;
      }
      .prose img {
        max-width: 100%;
      }
      .prose blockquote {
        border-left: 3px solid var(--accent);
        margin-left: 0;
        padding-left: 1rem;
        color: var(--muted);
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
      }
      th,
      td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        text-align: left;
      }
    </style>
  </body>
</html>
